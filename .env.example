# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings -> API). Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Not read by any Phase 1 code, but Canvas ingestion (Phase 6)
# and other server-side-only work will need it later. Never expose this to
# the client, never prefix it with NEXT_PUBLIC_. This is Supabase's newer
# sb_secret_... key (Settings -> API Keys -> "Publishable and secret API
# keys"), not the legacy JWT-based service_role key — same privileges
# (bypasses RLS), but independently rotatable and rejected outright if a
# browser ever sends it. Legacy service_role still works if that's what a
# given project has, but there's no reason to start a new one on it.
SUPABASE_SECRET_KEY=
