# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings -> API). Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Not read by any Phase 1 code, but Canvas ingestion (Phase 6)
# and other server-side-only work will need it later. Never expose this to
# the client, never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
